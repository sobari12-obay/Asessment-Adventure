# GEMINI_API_KEY: Required for server-side Gemini AI document/question parsing (never prefix with VITE_).
# In AI Studio or Cloud Run, inject via Secrets / Secret Manager (never commit real keys).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL of the deployed Cloud Run or AI Studio service.
APP_URL="MY_APP_URL"

# PORT: Port injected by Cloud Run (default 3000 in local development).
PORT=3000

# NODE_ENV: "development" or "production"
NODE_ENV="development"

# STUDENT_SESSION_SECRET: Optional 32+ byte secret for HMAC-SHA256 student session tokens.
# Leave unset in local preview to use an ephemeral runtime secret; configure via Secret Manager in Cloud Run.
STUDENT_SESSION_SECRET=

# FIREBASE_PROJECT_ID: Optional override for backend token verification (defaults to firebase-applet-config.json).
FIREBASE_PROJECT_ID=

# FIREBASE_DATABASE_ID: Optional override for Firestore database ID (defaults to firebase-applet-config.json).
FIREBASE_DATABASE_ID=

